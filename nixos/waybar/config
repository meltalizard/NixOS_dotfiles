{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "modules-left": ["hyprland/workspaces", "hyprland/mode"],
    "modules-center": [],
    "modules-right": ["network", "cpu", "memory", "pulseaudio", "battery", "clock"],
    
    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true
    },
    
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip": false
    },
    
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    
    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "eth",
        "format-disconnected": "disconnected"
    },
    
    "pulseaudio": {
        "format": "♪ {volume}%"
    }
}
